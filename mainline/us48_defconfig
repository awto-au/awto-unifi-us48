# US-48-500W mainline: used with `make allnoconfig` (KCONFIG_ALLCONFIG), every other symbol is off (#64)
# Platform: BCM53344 HR2, one Cortex-A9, no VFP, SMP off
CONFIG_MMU=y
CONFIG_ARCH_MULTIPLATFORM=y
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_BCM=y
CONFIG_ARCH_BCM_HR2=y
# CONFIG_SMP is not set
CONFIG_ARM_THUMB=y
CONFIG_HIGHMEM=y
CONFIG_CMA=y
CONFIG_DMA_CMA=y
# Tick: oneshot clockevents (arm_global_timer, per CPU, no broadcast needed) for hrtimers; HZ is per profile. #84 item 6
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_KUSER_HELPERS=y
# No Spectre mitigations: no untrusted code on this box; BPIALL on every kernel entry costs CPU
# CONFIG_HARDEN_BRANCH_PREDICTOR is not set
# CONFIG_HARDEN_BRANCH_HISTORY is not set
CONFIG_CACHE_L2X0=y
CONFIG_PL310_ERRATA_588369=y
CONFIG_PL310_ERRATA_727915=y
CONFIG_PL310_ERRATA_753970=y
CONFIG_PL310_ERRATA_769419=y
CONFIG_ARM_ERRATA_430973=y
CONFIG_ARM_ERRATA_720789=y
CONFIG_ARM_ERRATA_754322=y
CONFIG_ARM_ERRATA_775420=y
CONFIG_ARM_ERRATA_814220=y
CONFIG_ARM_GIC=y
CONFIG_ARM_GLOBAL_TIMER=y
CONFIG_ARM_TIMER_SP804=y
CONFIG_COMMON_CLK=y
CONFIG_CLK_BCM_HR2=y
# Boot: appended DTB, initramfs, cmdline from the DTB/kernel
CONFIG_ARM_APPENDED_DTB=y
# CONFIG_ARM_ATAG_DTB_COMPAT is not set
CONFIG_CMDLINE="console=ttyS0,115200 earlycon cma=8M@32M-64M"
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_KERNEL_GZIP=y
CONFIG_INITRAMFS_COMPRESSION_GZIP=y
# Core + userspace (busybox init, dropbear: mainline/rootfs)
CONFIG_EXPERT=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_MULTIUSER=y
CONFIG_FILE_LOCKING=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_POSIX_TIMERS=y
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_INOTIFY_USER=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_DEVMEM=y
# CONFIG_STRICT_DEVMEM is not set
CONFIG_SYSCTL=y
CONFIG_BLOCK=y
CONFIG_MISC_FILESYSTEMS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_XZ=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# Networking: us48_cmic is a plain netdev driver
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_INET=y
CONFIG_IP_MULTICAST=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_IGMP_SNOOPING=y
# us48_cmic switchdev L2 offload (docs/switchdev.md, #57); VLAN-aware bridges offloaded per bridge VID
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_NET_SWITCHDEV=y
CONFIG_VLAN_8021Q=y
CONFIG_NET_CORE=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_TUN=y
# Route/NAT/firewall tests (docs/route-nat-fw.md): netns + nftables (nf_tables, conntrack, NAT, SW flowtable) as modules, loaded by modprobe
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_INGRESS=y
CONFIG_NF_CONNTRACK=m
CONFIG_NF_CONNTRACK_PROCFS=y
CONFIG_NF_NAT=m
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_REJECT=m
CONFIG_NF_LOG_SYSLOG=m
CONFIG_NF_FLOW_TABLE=m
CONFIG_NF_FLOW_TABLE_INET=m
CONFIG_NFT_FLOW_OFFLOAD=m
# Hardware
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y
# a2 console (same image on a1 and a2; a2 DTB bootargs select it, a1 never registers it: no DCC reader there)
CONFIG_HVC_DCC=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_BCM2835=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCI_QUIRKS=y
CONFIG_PCIEASPM=y
CONFIG_PCIEASPM_DEFAULT=y
CONFIG_PCIE_IPROC_PLATFORM=y
CONFIG_PCIE_IPROC_MSI=y
# a2 (unit 1 A9): us48_pci aux parent + us48_a2 remoteproc, out of tree (kernel/us48-*); AUXILIARY_BUS prompt = mainline/0011
CONFIG_AUXILIARY_BUS=y
CONFIG_REMOTEPROC=y
# on-chip SRAM pools (mmio-sram, #84 item 12)
CONFIG_SRAM=y
CONFIG_SPI=y
CONFIG_SPI_MEM=y
CONFIG_SPI_BCM_QSPI=y
CONFIG_MTD=y
CONFIG_MTD_OF_PARTS=y
CONFIG_MTD_SPI_NOR=y
CONFIG_MTD_SPI_NOR_USE_4K_SECTORS=y
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_BCM_IPROC=y
CONFIG_I2C_MUX=y
CONFIG_I2C_MUX_PCA954x=y
CONFIG_HWMON=y
CONFIG_SENSORS_LM75=y
# Fans + temperatures (#19): thermal zones in the DT, step_wise, hwmon view of the sensors; fan/pvtmon/mspi/gpio are out of tree
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_THERMAL_HWMON=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_THERMAL_DEFAULT_GOV_STEP_WISE=y
CONFIG_WATCHDOG=y
CONFIG_ARM_SP805_WATCHDOG=y
# SP805 is armed by awto-uboot (~46 s): built in, and the core feeds it until userspace opens /dev/watchdog (replaces the busybox feeder, #84)
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
# Core SoC test kit (#84): PL330 as a module (IDM reset must be released first, docs/core-bringup.md); iproc-rng200 does not fit the HR2 RNG layout
CONFIG_DMADEVICES=y
CONFIG_PL330_DMA=m
# Without it reset_control_get_optional() is a stub returning NULL: pl330 never deasserts dmac_idm (#84)
CONFIG_RESET_CONTROLLER=y
CONFIG_GPIOLIB=y
CONFIG_PINCTRL_IPROC_GPIO=y
CONFIG_MFD_SYSCON=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SYSCON=y
# Debug options live in us48_debug.config; us48_normal.config has none (docs/mainline.md profiles)
CONFIG_PRINTK_TIME=y
# Fixed kernel.release per profile: LOCALVERSION from the profile fragment, no git hash (#64)
# CONFIG_LOCALVERSION_AUTO is not set
