From 3724414a60d6f13c9e9bc9fc3673f2339465776d Mon Sep 17 00:00:00 2001
From: Dan on Selwyn <dan@awto.au>
Date: Mon, 23 Nov 2026 17:39:00 +1100
Subject: [PATCH 33/33] ARM: dts: broadcom: us-48-500w: Wire the CMIC SMBus
 interrupt

CMC0 IRQ_STAT1 bit 0 (I2C_INTR) through UC0_IRQ_MASK1 reaches GIC SPI 162; a small interrupt controller (us48_cmic_irq) owns the mask bit.
---
 .../broadcom/bcm53344-ubnt-unifi-us-48-500w.dts    | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/arch/arm/boot/dts/broadcom/bcm53344-ubnt-unifi-us-48-500w.dts b/arch/arm/boot/dts/broadcom/bcm53344-ubnt-unifi-us-48-500w.dts
index 58b82855e..f974a9b77 100644
--- a/arch/arm/boot/dts/broadcom/bcm53344-ubnt-unifi-us-48-500w.dts
+++ b/arch/arm/boot/dts/broadcom/bcm53344-ubnt-unifi-us-48-500w.dts
@@ -378,10 +378,22 @@ port@34 {
 		};
 	};
 
-	/* SMBus controller in the CMIC of the BCM53344, no interrupt wired */
+	/* CMIC CMC0 interrupt status: bit 0 = SMBus; UC0_IRQ_MASK1 routes it to GIC SPI 162 (bench-verified, #158) */
+	cmic_irq: interrupt-controller@48031404 {
+		compatible = "ubnt,us48-cmic-irq";
+		reg = <0x48031404 0x30>;
+		interrupt-controller;
+		#interrupt-cells = <1>;
+		interrupt-parent = <&gic>;
+		interrupts = <GIC_SPI 162 IRQ_TYPE_LEVEL_HIGH>;
+	};
+
+	/* SMBus controller in the CMIC of the BCM53344 */
 	i2c@48000000 {
 		compatible = "brcm,iproc-i2c";
 		reg = <0x48000000 0x50>;
+		interrupt-parent = <&cmic_irq>;
+		interrupts = <0>;
 		#address-cells = <1>;
 		#size-cells = <0>;
 		clock-frequency = <100000>;
