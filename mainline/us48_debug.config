# Profile debug (default for general work): every check that exists and works on ARM32 / this SoC.
# Not available here: KCSAN, KMSAN, KASAN_SW/HW_TAGS (no ARM32), RCU stall detector (TINY_RCU, SMP off), DMA_API_DEBUG_SG + DEBUG_TIMEKEEPING (gone in 7.4); see docs/mainline.md
# HZ_250: the checks make every tick dearer; hrtimers (HIGH_RES_TIMERS, base) do not depend on HZ
CONFIG_HZ_250=y
CONFIG_LOCALVERSION="-dbg"
CONFIG_DEBUG_KERNEL=y
# memory
# FLATMEM memmap spans the 0x08000000..0x68000000 hole (14 MiB)
CONFIG_SPARSEMEM_MANUAL=y
# bank 1 (0x68000000) becomes lowmem: with 3G/1G only ~56 MiB of non-movable lowmem was left (OOM at boot)
CONFIG_VMSPLIT_1G=y
# KASAN generic outline; memory-map reasons for SPARSEMEM + VMSPLIT_1G: docs/mainline.md (#84)
CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y
CONFIG_KASAN_OUTLINE=y
CONFIG_KASAN_STACK=y
CONFIG_KFENCE=y
CONFIG_KFENCE_NUM_OBJECTS=63
CONFIG_SLUB_DEBUG=y
CONFIG_SLUB_DEBUG_ON=y
CONFIG_DEBUG_PAGEALLOC=y
CONFIG_DEBUG_PAGEALLOC_ENABLE_DEFAULT=y
CONFIG_PAGE_POISONING=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_DEBUG_VM=y
CONFIG_DEBUG_VM_PGFLAGS=y
CONFIG_DEBUG_KMEMLEAK=y
CONFIG_DEBUG_KMEMLEAK_MEM_POOL_SIZE=8000
CONFIG_DEBUG_SG=y
CONFIG_DEBUG_LIST=y
CONFIG_DEBUG_PLIST=y
CONFIG_DEBUG_NOTIFIERS=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_SCHED_STACK_END_CHECK=y
CONFIG_DEBUG_STACK_USAGE=y
# locking
CONFIG_PROVE_LOCKING=y
# lockdep tables sized down (lowmem budget, docs/mainline.md)
CONFIG_LOCKDEP_BITS=14
CONFIG_LOCKDEP_CHAINS_BITS=15
CONFIG_LOCKDEP_STACK_TRACE_BITS=17
CONFIG_LOCKDEP_STACK_TRACE_HASH_BITS=12
CONFIG_LOCKDEP_CIRCULAR_QUEUE_BITS=11
CONFIG_DEBUG_LOCK_ALLOC=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_DEBUG_SPINLOCK=y
CONFIG_DEBUG_MUTEXES=y
CONFIG_DEBUG_RWSEMS=y
CONFIG_DEBUG_WW_MUTEX_SLOWPATH=y
CONFIG_PROVE_RCU=y
CONFIG_DEBUG_OBJECTS=y
CONFIG_DEBUG_OBJECTS_FREE=y
CONFIG_DEBUG_OBJECTS_TIMERS=y
CONFIG_DEBUG_OBJECTS_WORK=y
CONFIG_DEBUG_OBJECTS_RCU_HEAD=y
CONFIG_DEBUG_OBJECTS_PERCPU_COUNTER=y
# drivers and DMA
CONFIG_DMA_API_DEBUG=y
CONFIG_DEBUG_SHIRQ=y
CONFIG_DEBUG_DEVRES=y
# hangs
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=1
CONFIG_DETECT_HUNG_TASK=y
CONFIG_WQ_WATCHDOG=y
# undefined behaviour
CONFIG_UBSAN=y
CONFIG_UBSAN_BOUNDS=y
CONFIG_UBSAN_SHIFT=y
CONFIG_UBSAN_UNREACHABLE=y
# introspection
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_FTRACE=y
CONFIG_EVENT_TRACING=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_PERF_EVENTS=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_DEBUG_FS=y
CONFIG_DEBUG_FS_ALLOW_ALL=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_MAGIC_SYSRQ_SERIAL=y
CONFIG_PANIC_ON_OOPS=y
# core SoC test kit (#84): self-test modules, loaded by hand through scripts/core_test.py, never in the normal profile
CONFIG_DMATEST=m
CONFIG_RUNTIME_TESTING_MENU=y
CONFIG_TEST_BITMAP=m
CONFIG_TEST_UDELAY=m
CONFIG_LOCK_TORTURE_TEST=m
CONFIG_RCU_TORTURE_TEST=m
