#!/bin/sh
# Switch port driver first: ge1 = management (house LAN test address), xe49/xe50 = second chip 10G.
# Early matters: stock leaves unit 1 RX DMA running into old RAM until the driver aborts it.

IP=192.168.25.207/24	# ip-registry: us48-boot
M=/lib/modules/$(uname -r)

exec 2>/dev/kmsg
echo "us48-net: insmod" > /dev/kmsg
# CMIC interrupt controller first: the built-in I2C driver (PoE, SFP, sensors) defers its probe until it exists (#158)
insmod $M/us48_cmic_irq.ko || echo "us48-net: insmod us48_cmic_irq failed rc=$?" > /dev/kmsg
# Core + unit 0 (ge1, management) first; the unit 1 front-end is a separate module (rmmod us48_cmic_xe leaves ge1 up).
insmod $M/us48_cmic.ko unit0=1 || { echo "us48-net: insmod failed rc=$?" > /dev/kmsg; exit 1; }
# us48_pci creates the aux devices (a2, cmic, clk); the xe driver binds to us48_pci.cmic
insmod $M/us48_pci.ko || echo "us48-net: insmod us48_pci failed rc=$?" > /dev/kmsg
insmod $M/us48_cmic_xe.ko || echo "us48-net: insmod xe failed rc=$?" > /dev/kmsg
for i in ge1 xe49 xe50; do
	echo 1 > /proc/sys/net/ipv6/conf/$i/disable_ipv6
	ip link set $i up
done
# SFP 1/2 (unit 0, #143): netdevs exist and the TSC is powered, admin down until used
for i in xe51 xe52; do
	echo 1 > /proc/sys/net/ipv6/conf/$i/disable_ipv6
done
ip addr add $IP dev ge1
echo "us48-net: done" > /dev/kmsg
