#!/bin/sh
# PoE on at boot, all 48 ports (Dan 2026-11-21). The chips come up without firmware after a cold boot (reg 0x75 = 0):
# fw_load=1 loads v21 into each of the 12 chips (~4 s each), so it runs in the background and does not delay the boot.
# Max power: 30 W/port reserved (class 4), DT budget 1440 W = 48 x 30 W (stock PSU budget 436 W is not enforced here). Parameters and safety: docs/poe-pse.md; kill switch: `us48-poe-off`.

M=/lib/modules/$(uname -r)
EN=0xffffffffffff
OV=
# bench: override file = one chip runs a test image; every port stays shut
[ -s /etc/poe-fw-override ] && { OV="fw_override=$(cat /etc/poe-fw-override)"; EN=0; }
[ -d /sys/module/bcm59111 ] && exit 0
# bcm59111 links against us48_boardio (portN_mode, passive 24 V); S14us48-thermal skips it when loaded
[ -d /sys/module/us48_boardio ] || insmod $M/us48_boardio.ko || echo "us48-poe: insmod us48_boardio failed rc=$?" > /dev/kmsg
(
	exec 2>/dev/kmsg
	insmod $M/bcm59111.ko fw_load=1 enable_ports=$EN $OV || echo "us48-poe: insmod bcm59111 failed rc=$?" > /dev/kmsg
) &
