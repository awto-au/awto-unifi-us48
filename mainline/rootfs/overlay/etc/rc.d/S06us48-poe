#!/bin/sh
# PoE on at boot, all 48 ports (Dan 2026-11-21). The chips come up without firmware after a cold boot (reg 0x75 = 0):
# fw_load=1 loads v21 into each of the 12 chips (~4 s each), so it runs in the background and does not delay the boot.
# Budget: DT regulators (436 W). Parameters and safety: docs/poe-pse.md; kill switch: `us48-poe-off`.

M=/lib/modules/$(uname -r)
[ -d /sys/module/bcm59111 ] && exit 0
(
	exec 2>/dev/kmsg
	insmod $M/bcm59111.ko fw_load=1 enable_ports=0xffffffffffff || echo "us48-poe: insmod bcm59111 failed rc=$?" > /dev/kmsg
) &
