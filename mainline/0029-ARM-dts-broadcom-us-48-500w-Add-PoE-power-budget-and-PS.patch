+	/*
+	 * PoE power budget: 500 W PSU - 64 W reserved = 436 W (ubnthal, docs/poe.md 7), one supply per PoE card below it.
+	 * The 54 V is nominal. The per-card limit equals the total: the real split between the cards is unknown.
+	 */
+	poe_total: regulator-poe-total {
+		compatible = "regulator-fixed";
+		regulator-name = "poe-total";
+		regulator-min-microvolt = <54000000>;
+		regulator-max-microvolt = <54000000>;
+		regulator-power-budget-milliwatt = <1440000>;
+	};
+
+	poe_card0: regulator-poe-card0 {
+		compatible = "regulator-fixed";
+		regulator-name = "poe-card0";
+		regulator-min-microvolt = <54000000>;
+		regulator-max-microvolt = <54000000>;
+		regulator-power-budget-milliwatt = <1440000>;
+		vin-supply = <&poe_total>;
+	};
+
+	poe_card1: regulator-poe-card1 {
+		compatible = "regulator-fixed";
+		regulator-name = "poe-card1";
+		regulator-min-microvolt = <54000000>;
+		regulator-max-microvolt = <54000000>;
+		regulator-power-budget-milliwatt = <1440000>;
+		vin-supply = <&poe_total>;
+	};
+
