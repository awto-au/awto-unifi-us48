--- /dev/null
+++ b/src/include/musl-sched.h
@@ -0,0 +1,22 @@
+/* musl returns ENOSYS from sched_{get,set}scheduler and sched_setparam by design; call the kernel directly. */
+#ifndef MUSL_SCHED_H
+#define MUSL_SCHED_H
+
+#include <sched.h>
+#include <unistd.h>
+#include <sys/syscall.h>
+
+#undef sched_getscheduler
+#undef sched_setscheduler
+#undef sched_getparam
+#undef sched_setparam
+#define sched_getscheduler(pid) \
+	((int)syscall(SYS_sched_getscheduler, (pid)))
+#define sched_setscheduler(pid, policy, param) \
+	((int)syscall(SYS_sched_setscheduler, (pid), (policy), (param)))
+#define sched_getparam(pid, param) \
+	((int)syscall(SYS_sched_getparam, (pid), (param)))
+#define sched_setparam(pid, param) \
+	((int)syscall(SYS_sched_setparam, (pid), (param)))
+
+#endif
