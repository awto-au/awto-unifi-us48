Subject: cmd: sf accepts probe and read only (us48 never writes flash)

Base: U-Boot v2026.07. Other files are staged from uboot-port/ by scripts/build_uboot.py.

diff --git a/cmd/sf.c b/cmd/sf.c
index b5b7f671fb9..82e77f92690 100644
--- a/cmd/sf.c
+++ b/cmd/sf.c
@@ -601,6 +601,55 @@ static int do_spi_flash(struct cmd_tbl *cmdtp, int flag, int argc,
 	if (strcmp(cmd, "probe") == 0)
 		return do_spi_flash_probe(argc, argv);
 
+	/*
+	 * us48: read-only build except erase/write inside kernel0 (0xe0000..0xfe0000) and the env partition
+	 * (exactly 0xc0000, 64 KiB, #63); elsewhere could hit u-boot, bootsel, kernel1 or EEPROM.
+	 */
+	if (strcmp(cmd, "read") && strcmp(cmd, "scur")) {
+		extern void us48_net_quiesce(void) __attribute__((weak));
+		ulong off = 0, len = 0;
+		bool ok = false;
+
+		if (!strcmp(cmd, "erase") && argc == 3) {
+			off = hextoul(argv[1], NULL);
+			len = hextoul(argv[2], NULL);
+			ok = true;
+		} else if (!strcmp(cmd, "write") && argc == 4) {
+			off = hextoul(argv[2], NULL);
+			len = hextoul(argv[3], NULL);
+			ok = true;
+		}
+		if (!ok || !((off == 0xc0000 && len == 0x10000) || (off >= 0xe0000 && len <= 0xf00000 && off + len <= 0xfe0000))) {
+			printf("sf %s: disabled in this build (read-only), erase/write only 0xc0000+0x10000 or inside 0xe0000..0xfe0000\n", cmd);
+			return CMD_RET_FAILURE;
+		}
+		/* #104: no frames queue in the chip for the CPU during the long erase/write; the next net start resumes */
+		if (us48_net_quiesce)
+			us48_net_quiesce();
+	}
+
+	/* us48: print the Macronix security register; bit 2 = flash is in 4-byte address mode (should be 0) */
+	if (strcmp(cmd, "scur") == 0) {
+		u8 scur = 0;
+		int r;
+
+		if (!flash) {
+			puts("No SPI flash selected. Please run `sf probe'\n");
+			return CMD_RET_FAILURE;
+		}
+		r = flash->read_reg(flash, 0x2b, &scur, 1);
+		printf("RDSCUR %02x: 4BYTE (bit 2) = %d\n", scur, (scur >> 2) & 1);
+		/* #20: QE (RDSR bit 6) gates quad I/O; RDCR 15h = config */
+		{
+			u8 sr = 0, cr = 0;
+
+			r |= flash->read_reg(flash, 0x05, &sr, 1);
+			r |= flash->read_reg(flash, 0x15, &cr, 1);
+			printf("RDSR %02x: QE (bit 6) = %d; RDCR %02x\n", sr, (sr >> 6) & 1, cr);
+		}
+		return r ? CMD_RET_FAILURE : CMD_RET_SUCCESS;
+	}
+
 	/* The remaining commands require a selected device */
 	if (!flash) {
 		puts("No SPI flash selected. Please run `sf probe'\n");
