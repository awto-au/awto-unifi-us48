// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
/*
 * Ubiquiti UniFi Switch 48 PoE 500W (US-48-500W), second-stage U-Boot.
 * Node layout follows bcm-hr2.dtsi + the board DTS in the Linux tree
 * (mainline/0005, 0007); only what U-Boot uses (M1 + M2 QSPI) is listed.
 */

/dts-v1/;

/ {
	compatible = "ubnt,unifi-us-48-500w", "brcm,bcm53344", "brcm,hr2";
	model = "Ubiquiti UniFi Switch 48 PoE 500W";
	interrupt-parent = <&gic>;
	#address-cells = <1>;
	#size-cells = <1>;

	aliases {
		serial0 = &uart1;
		watchdog0 = &watchdog;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a9";
			reg = <0x0>;
		};
	};

	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x08000000>,
		      <0x68000000 0x08000000>;
	};

	clocks {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		apb_clk: clock-apb {
			#clock-cells = <0>;
			compatible = "fixed-clock";
			clock-frequency = <50000000>;
		};

		/* ARM/2 read from the ARM PLL regs (board.c) */
		periph_clk: periph_clk {
			#clock-cells = <0>;
			compatible = "awto,us48-periph-clk";
		};
	};

	mpcore@19000000 {
		compatible = "simple-bus";
		ranges = <0x00000000 0x19000000 0x00023000>;
		#address-cells = <1>;
		#size-cells = <1>;

		timer@20200 {
			compatible = "arm,cortex-a9-global-timer";
			reg = <0x20200 0x100>;
			clocks = <&periph_clk>;
		};

		gic: interrupt-controller@21000 {
			compatible = "arm,cortex-a9-gic";
			#interrupt-cells = <3>;
			#address-cells = <0>;
			interrupt-controller;
			reg = <0x21000 0x1000>,
			      <0x20100 0x100>;
		};
	};

	axi@18000000 {
		compatible = "simple-bus";
		ranges = <0x00000000 0x18000000 0x0011c40c>;
		#address-cells = <1>;
		#size-cells = <1>;

		uart1: serial@400 {
			compatible = "ns16550a";
			reg = <0x0400 0x100>;
			clock-frequency = <50000000>;
		};

		/*
		 * reg values: bcm-hr2.dtsi qspi@27200 (mspi 0x27200/0x184, bspi 0x27000/0x124).
		 * bspi_raf = bspi + 0x100 (RAF regs 0x00..0x20, the tail of the 0x124 bspi window,
		 * as Linux spi-bcm-qspi); U-Boot iproc_qspi wants it as its own reg-name.
		 */
		qspi: spi@27200 {
			compatible = "brcm,iproc-qspi";
			reg = <0x27200 0x184>, <0x27000 0x124>, <0x27100 0x24>;
			reg-names = "mspi", "bspi", "bspi_raf";
			#address-cells = <1>;
			#size-cells = <0>;

			/* mainline/0007: jedec,spi-nor, 12.5 MHz, mode 3; MX25L25635E 32 MiB, no partitions here */
			flash@0 {
				compatible = "jedec,spi-nor";
				reg = <0>;
				spi-max-frequency = <12500000>;
				spi-rx-bus-width = <4>;	/* #20: quad read (IO2/IO3 wiring + QE under test) */
				spi-cpol;
				spi-cpha;
			};
		};

		watchdog: watchdog@39000 {
			compatible = "arm,sp805", "arm,primecell";
			reg = <0x39000 0x1000>;
			clocks = <&apb_clk>, <&apb_clk>;
			clock-names = "wdog_clk", "apb_pclk";
			/* running at entry (dev.py arms it); first expiry = IRQ, second = reset */
			timeout-sec = <10>;
			u-boot,autostart;
		};

		dmu: syscon@3f000 {
			compatible = "brcm,hr2-dmu", "syscon";
			reg = <0x3f000 0x1000>;
		};
	};

	/* BCM53346 CMIC = PCIe BAR2, already enumerated by stock U-Boot (docs/uboot-second-stage.md M3) */
	ethernet@8040000 {
		compatible = "ubnt,us48-cmic-eth";
		reg = <0x08040000 0x40000>;
	};

	/* same restart as Linux: clear DMU 0x3f200 bit 1 */
	reboot {
		compatible = "syscon-reboot";
		regmap = <&dmu>;
		offset = <0x200>;
		mask = <0x2>;
		value = <0x0>;
	};
};
