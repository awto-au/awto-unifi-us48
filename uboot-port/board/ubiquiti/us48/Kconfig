if TARGET_US48

config SYS_BOARD
	default "us48"

config SYS_VENDOR
	default "ubiquiti"

config SYS_CONFIG_NAME
	default "us48"

config US48_CPU_MHZ
	int "A9 clock set by uboot-2 at early init (400, 800, or 1000..1999)"
	default 400
	range 400 1999
	help
	  400 = no change. 800 = fid 7 (docs/clocks.md E1). 1000..1999 = relock (E2),
	  ndiv = MHz x 2 / 25, so MHz x 2 must be a multiple of 25 (50 MHz steps are).
	  Above 1200 (VCO 2400) no Broadcom table row exists: docs/clock-audit.md.
	  Refuses and stays at 400 if the E0 gate fails. Other values: build error.

config US48_SRAM_CLK
	bool "Run the CPU clock switch from SRAM with rollback (docs/sram-clock-switch.md)"
	default n
	help
	  UNTESTED. Replaces the DDR-resident E1/E2 code in board.c.

config US48_SRAM_CLK_GENPLL
	bool "Enable GENPLL ch3/ch4 (AXI) SRAM entry point - DISABLED by default, high risk"
	depends on US48_SRAM_CLK
	default n
	help
	  UNTESTED. docs/clocks.md E5. No caller in the tree; changes AXI clock.

endif
