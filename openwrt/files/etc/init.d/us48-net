#!/bin/sh /etc/rc.common
# Load the switch port driver as early as possible: ge1 = management (house LAN test address), xe49/xe50 = second chip 10G.
# Early matters: stock leaves unit 1 RX DMA running into old RAM until the driver aborts it.

START=04
USE_PROCD=0

IP=192.168.25.207/24	# ip-registry: us48-boot

boot() {
	start
}

start() {
	# unit0=1: management port ge1 (front 1, first chip, 1G uplink to sw1) next to the second chip's ports.
	insmod /lib/us48/us48_cmic.ko unit0=1 2>/dev/null || busybox insmod /lib/us48/us48_cmic.ko unit0=1 || return 1
	for i in ge1 xe49 xe50; do
		echo 1 > /proc/sys/net/ipv6/conf/$i/disable_ipv6
		ip link set $i up
	done
	ip addr add $IP dev ge1
}
