#!/bin/sh /etc/rc.common
# Bench fan quiet mode (us48-fand); procd respawns it.

START=15
USE_PROCD=1

# Disabled while the fan driver is present (cooling device "us48-fan"); /etc/us48-fand.force overrides (docs/fan.md).
driver_present() {
	grep -qs '^us48-fan$' /sys/class/thermal/cooling_device*/type
}

start_service() {
	[ -e /etc/us48-fand.force ] || ! driver_present || { logger -t us48-fand "fan driver present: not started"; return 0; }
	procd_open_instance
	procd_set_param command /usr/sbin/us48-fand
	procd_set_param respawn 3600 5 0
	procd_close_instance
}
