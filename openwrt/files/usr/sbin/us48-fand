#!/bin/sh
# us48-fand — US-48 fan policy: QUIET (50 %) until a board LM75 reads >= 80 C, FULL until all LM75 <= 50 C;
# FULL also if either die PVTMON >= 100 C, or any sensor is unreadable (Dan 2026-11-15).
# Temps: max of the LM75s (hwmon) + PVTMON via CMIC S-channel (CMC1). Fans: 7-byte MSPI board-IO frame on CMIC unit 0, chain (1,0) (docs/fan.md).
# Bench-only: replaced by a hwmon cooling device + thermal-zone trips (awto-unifi-us48#15, #12, #19).

HIGH=80000; LOW=50000; DIE_HIGH=100000; POLL=2
QUIET=0x00   # 50 % preset (fan-off bits under test, #12)
FULL=0x30    # 100 % preset
MSPI=0x48001500; GP=0x48002000
GP1=0x0a002000   # BCM53346 CMIC GP (PCIe 01:00.0 BAR 2) = select line B
PCI1=/sys/bus/pci/devices/0000:01:00.0

w() { devmem "$1" 32 "$2"; }

fan() {  # $1 = byte 0; frame to chain (1,0) = unit 0 fans, then (1,1) = unit 1 fans
	for b in 0 1; do
		[ -e $PCI1/enable ] && { w $((GP1 + 4)) $b; w $((GP1 + 8)) 1; }   # B, output
		frame "$1"
	done
}

frame() {
	w $((GP + 4)) 1; w $((GP + 8)) 1           # GP0 = A = 1, output
	w $((MSPI + 0x180)) 1                      # CMICM_BSPI_MAST_N_BOOT: MSPI owns the bus
	w $MSPI 0x8d; w $((MSPI + 4)) 0x83; w $((MSPI + 8)) 1; w $((MSPI + 12)) 1
	i=0
	for b in $1 0 0 0 0 0 0; do
		w $((MSPI + 0x40 + 8 * i)) $b
		[ $i -lt 6 ] && c=0x80 || c=0
		w $((MSPI + 0x140 + 4 * i)) $c
		i=$((i + 1))
	done
	w $((MSPI + 0x10)) 0; w $((MSPI + 0x14)) 6; w $((MSPI + 0x20)) 0; w $((MSPI + 0x18)) 0x40
	n=0; while [ $(( $(devmem $((MSPI + 0x20)) 32) & 1 )) = 0 ] && [ $n -lt 100 ]; do n=$((n + 1)); done  # SPIF
}

# BCM53346 BAR decode is off until something enables the device (no driver bound yet).
[ -e $PCI1/enable ] && [ "$(cat $PCI1/enable)" = 0 ] && echo 1 > $PCI1/enable

maxtemp() {   # LM75 max in mC; -1 if any of the 4 is unreadable
	m=-1; n=0
	for t in /sys/class/hwmon/hwmon*/temp1_input; do
		v=$(cat "$t" 2>/dev/null) || { echo -1; return; }
		n=$((n + 1))
		[ "$v" -gt "$m" ] && m=$v
	done
	[ $n -lt 4 ] && m=-1
	echo $m
}

# PVTMON die temp of unit $1 (0/1) in mC via S-channel on CMC1 (TOP block 16); -1 if unreadable (docs/clocks.md PVTMON)
schan() {   # $1 = cmc base, $2 = op (0xb read, 0xd write), $3 = addr, $4 = data; prints data word, rc 1 on DONE clear / error bits
	w $(($1 + 0xC)) $(( $2 << 26 | 16 << 20 | 4 << 7 )); w $(($1 + 0x10)) $3
	[ "$2" = 13 ] && w $(($1 + 0x14)) $4
	w $1 1
	c=$(devmem $1 32); devmem $(($1 + 0xC)) 32 >/dev/null; d=$(devmem $(($1 + 0x10)) 32); w $1 0
	[ $(( c & 2 )) = 0 ] || [ $(( c & 0x700000 )) != 0 ] && return 1
	echo $d
}
pvt() {
	cmc=$(( ($1 == 0 ? 0x48000000 : 0x0a000000) + 0x32000 ))
	[ $1 = 1 ] && [ ! -e $PCI1/enable ] && { echo -1; return; }
	r=$(schan $cmc 11 $((0x02050400))) || { echo -1; return; }
	if [ $(( r & 0x80000000 )) = 0 ]; then
		schan $cmc 13 $((0x02050000)) 0x001D2003 >/dev/null; schan $cmc 13 $((0x02050400)) 0 >/dev/null
		schan $cmc 13 $((0x02050400)) 0x80000000 >/dev/null
	fi
	r=$(schan $cmc 11 $((0x02050800))) || { echo -1; return; }
	code=$(( r & 0x3ff ))
	[ $code = 0 ] && { echo -1; return; }
	echo $(( (4180000 - 5556 * code) / 10 ))
}
diemax() {  # max die temp in mC, -1 if either unreadable
	a=$(pvt 0); b=$(pvt 1)
	[ "$a" -lt 0 ] || [ "$b" -lt 0 ] && { echo -1; return; }
	[ "$a" -gt "$b" ] && echo $a || echo $b
}

state=full; fan $FULL
logger -t us48-fand "start: full until temps read (high ${HIGH} low ${LOW})"
while :; do
	t=$(maxtemp); d=$(diemax)
	[ "$d" -lt 0 ] && t=-1          # unreadable die sensor = no sensors
	[ "$d" -ge $DIE_HIGH ] && t=$HIGH   # die >= 100 C = FULL; returns once LM75 <= LOW
	if [ "$state" = full ] && [ -z "$seen" ] && [ "$t" -ge 0 ]; then
		seen=1   # first reading: quiet unless already hot (LOW is only the post-alert return point)
		[ "$t" -lt $HIGH ] && { fan $QUIET; state=quiet; logger -t us48-fand "first read ${t}: QUIET"; }
	elif [ "$t" -lt 0 ]; then
		[ $state = full ] || { fan $FULL; state=full; logger -t us48-fand "no sensors: FULL"; }
	elif [ $state = full ] && [ "$t" -le $LOW ]; then
		fan $QUIET; state=quiet; logger -t us48-fand "max ${t} <= ${LOW}: QUIET"
	elif [ $state = quiet ] && [ "$t" -ge $HIGH ]; then
		fan $FULL; state=full; logger -t us48-fand "max ${t} >= ${HIGH}: FULL (heat alert)"
	fi
	sleep $POLL
done
