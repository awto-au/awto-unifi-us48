diff --git a/target/linux/bcm53xx/dts/bcm53344-ubnt-unifi-us-48-500w.dts b/target/linux/bcm53xx/dts/bcm53344-ubnt-unifi-us-48-500w.dts
new file mode 100644
index 0000000..a19d7f1
--- /dev/null
+++ b/target/linux/bcm53xx/dts/bcm53344-ubnt-unifi-us-48-500w.dts
@@ -0,0 +1,184 @@
+// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
+/*
+ * Ubiquiti UniFi Switch 48 PoE 500W (US-48-500W, board 0xeb62)
+ * BCM53344 (HR2, integrated Cortex-A9) + BCM53346 on PCIe.
+ * Based on bcm53340-ubnt-unifi-switch8.dts; flash map matches stock mtdparts.
+ */
+
+/dts-v1/;
+
+#include "bcm-hr2.dtsi"
+
+/ {
+	compatible = "ubnt,unifi-us-48-500w", "brcm,bcm53344", "brcm,hr2";
+	model = "Ubiquiti UniFi Switch 48 PoE 500W";
+
+	aliases {
+		/* stock HR2 kernels register UART1 first: stock ttyS0 == uart1 */
+		serial0 = &uart1;
+	};
+
+	chosen {
+		bootargs = "console=ttyS0,115200 earlycon";
+		stdout-path = "serial0:115200n8";
+	};
+
+	memory@0 {
+		device_type = "memory";
+		reg = <0x00000000 0x08000000>,
+		      <0x68000000 0x08000000>;
+	};
+
+	/*
+	 * Board I2C (PCA9548 0x70 → PoE, temp, SFP): iProc SMBus inside the BCM53344 CMIC,
+	 * not the ChipcommonB i2c0/i2c1 (unused by stock). No IRQ wired → driver polls.
+	 * 100 kHz: SFP EEPROMs share the mux tree. docs/board.md "I2C master".
+	 */
+	i2c_cmic: i2c@48000000 {
+		compatible = "brcm,iproc-i2c";
+		reg = <0x48000000 0x50>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+		clock-frequency = <100000>;
+
+		/* mux0: ch4/5 PoE cards, ch6 LM75 x4, ch0-7 also SFP (docs/board.md); only ch6 described yet */
+		i2c-mux@70 {
+			compatible = "nxp,pca9548";
+			reg = <0x70>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			i2c-mux-idle-disconnect;
+
+			i2c@6 {
+				reg = <6>;
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				temp@48 { compatible = "national,lm75b"; reg = <0x48>; };
+				temp@49 { compatible = "national,lm75b"; reg = <0x49>; };
+				temp@4a { compatible = "national,lm75b"; reg = <0x4a>; };
+				temp@4b { compatible = "national,lm75b"; reg = <0x4b>; };
+			};
+		};
+	};
+};
+
+&uart1 {
+	/* dtsi says osc (25 MHz) → 8250 picks a 2x divisor, line runs at ~223 kbaud. */
+	clocks = <&apb_clk>;
+	status = "okay";
+};
+
+/*
+ * bcm-hr2.dtsi leaves SP805/SP804 without clocks → no probe → no restart handler ("Reboot failed --
+ * System halted"). APB = 50 MHz (stock: "UART clock rate 50000000", U-Boot apb_clk=50MHz).
+ */
+/ {
+	apb_clk: apb-clk {
+		#clock-cells = <0>;
+		compatible = "fixed-clock";
+		clock-frequency = <50000000>;
+	};
+};
+
+&watchdog {
+	clocks = <&apb_clk>, <&apb_clk>;
+	clock-names = "wdog_clk", "apb_pclk";
+};
+
+&ccbtimer0 {
+	clocks = <&apb_clk>, <&apb_clk>, <&apb_clk>;
+	clock-names = "timer0clk", "timer1clk", "apb_pclk";
+};
+
+&ccbtimer1 {
+	clocks = <&apb_clk>, <&apb_clk>, <&apb_clk>;
+	clock-names = "timer0clk", "timer1clk", "apb_pclk";
+};
+
+&qspi {
+	status = "okay";
+
+	flash@0 {
+		/* Macronix MX25L25635E, 32 MiB */
+		compatible = "jedec,spi-nor";
+		reg = <0>;
+		spi-max-frequency = <12500000>;
+		spi-cpol;
+		spi-cpha;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "u-boot";
+				reg = <0x0 0xc0000>;
+				read-only;
+			};
+
+			partition@c0000 {
+				label = "u-boot-env";
+				reg = <0xc0000 0x10000>;
+				read-only;
+			};
+
+			partition@d0000 {
+				label = "shmoo";
+				reg = <0xd0000 0x10000>;
+				read-only;
+			};
+
+			partition@e0000 {
+				label = "kernel0";
+				reg = <0xe0000 0xf00000>;
+				read-only;
+			};
+
+			partition@fe0000 {
+				label = "kernel1";
+				reg = <0xfe0000 0xf10000>;
+				read-only;
+			};
+
+			partition@1ef0000 {
+				label = "cfg";
+				reg = <0x1ef0000 0x100000>;
+				read-only;
+			};
+
+			partition@1ff0000 {
+				label = "EEPROM";
+				reg = <0x1ff0000 0x10000>;
+				read-only;
+			};
+		};
+	};
+};
+
+&pcie0 {
+	/* 01:00.0/.1 = BCM53346; local BCM53344 CMIC is AXI 0x48000000, not PCIe.
+	 * HR2 PAXB has no APB_ERR_EN (0xf40): patches-6.18/950 keys off this compatible. */
+	compatible = "brcm,iproc-hr2-pcie", "brcm,iproc-pcie";
+	status = "okay";
+};
+
+/* Stock restart (northstar_restart): clear bit 1 of DMU 0x1803f200 — whole-chip reset (awto-unifi-us48#11).
+ * syscon-reboot (prio 192) outranks sp805 restart; SP805 armed from U-Boot still covers early panics. */
+&{/axi@18000000} {
+	dmu: syscon@3f000 {
+		compatible = "syscon";
+		reg = <0x3f000 0x1000>;
+	};
+};
+
+/ {
+	reboot {
+		compatible = "syscon-reboot";
+		regmap = <&dmu>;
+		offset = <0x200>;
+		mask = <0x2>;
+		value = <0x0>;
+	};
+};
